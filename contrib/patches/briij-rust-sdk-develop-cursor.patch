@@ -0,0 +1,286 @@
+use std::{
+    env,
+    path::{Path, PathBuf},
+};
+
+use anyhow::{anyhow, bail, Context};
+use matrix_sdk::{
+    authentication::matrix::MatrixSession,
+    ruma::{OwnedDeviceId, OwnedUserId},
+    store::RoomLoadSettings,
+    Client, SessionMeta, SessionTokens,
+};
+use rand::{distributions::Alphanumeric, thread_rng, Rng};
+use reqwest::StatusCode;
+use serde::{Deserialize, Serialize};
+use tokio::fs;
+use url::Url;
+use xrpl::{core::keypairs::sign, wallet::Wallet};
+
+const XRPL_LOGIN_TYPE: &str = "org.textrp.login.xrpl";
+
+#[derive(Debug, Serialize, Deserialize)]
+struct ClientSession {
+    homeserver: String,
+    db_path: PathBuf,
+    passphrase: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+struct LinkedWalletSession {
+    address: String,
+    network: String,
+    public_key: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+struct StoredSession {
+    client_session: ClientSession,
+    user_session: MatrixSession,
+    linked_wallet: Option<LinkedWalletSession>,
+}
+
+#[derive(Debug, Serialize)]
+struct ChallengeRequest<'a> {
+    #[serde(rename = "type")]
+    login_type: &'a str,
+    address: &'a str,
+    network: &'a str,
+}
+
+#[derive(Debug, Deserialize)]
+struct ChallengeResponse {
+    session: String,
+    challenge: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct LoginResponseBody {
+    user_id: OwnedUserId,
+    access_token: String,
+    device_id: OwnedDeviceId,
+    refresh_token: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct CompleteLoginRequest<'a> {
+    #[serde(rename = "type")]
+    login_type: &'a str,
+    session: &'a str,
+    address: &'a str,
+    signature: &'a str,
+    public_key: &'a str,
+}
+
+#[tokio::main]
+async fn main() -> anyhow::Result<()> {
+    tracing_subscriber::fmt::init();
+
+    let args: Vec<String> = env::args().skip(1).collect();
+    let Some(command) = args.first().map(String::as_str) else {
+        print_usage();
+        bail!("missing command");
+    };
+
+    match command {
+        "login-xrpl" => {
+            let homeserver = required_flag(&args[1..], "--homeserver")?;
+            let network = required_flag(&args[1..], "--network")?;
+            login_xrpl(&homeserver, &network).await?;
+        }
+        "address" => {
+            show_linked_address().await?;
+        }
+        _ => {
+            print_usage();
+            bail!("unknown command: {command}");
+        }
+    }
+
+    Ok(())
+}
+
+fn print_usage() {
+    println!("Usage:");
+    println!("  briij-cli login-xrpl --homeserver <url> --network <xrpl|xahau>");
+    println!("  briij-cli address");
+}
+
+fn required_flag(args: &[String], flag: &str) -> anyhow::Result<String> {
+    let Some(index) = args.iter().position(|arg| arg == flag) else {
+        bail!("missing required flag: {flag}");
+    };
+
+    let Some(value) = args.get(index + 1) else {
+        bail!("missing value for flag: {flag}");
+    };
+
+    Ok(value.clone())
+}
+
+async fn login_xrpl(homeserver: &str, network: &str) -> anyhow::Result<()> {
+    if network != "xrpl" && network != "xahau" {
+        bail!("unsupported network: {network}");
+    }
+
+    let seed = env::var("BRIJJ_XRPL_SEED")
+        .or_else(|_| env::var("XRPL_SECRET_KEY"))
+        .context("set BRIJJ_XRPL_SEED or XRPL_SECRET_KEY before using login-xrpl")?;
+
+    let wallet = Wallet::new(&seed, 0)
+        .map_err(|error| anyhow!("failed to derive XRPL wallet from seed: {error:?}"))?;
+    let homeserver_url = normalize_homeserver_url(homeserver)?;
+    let login_url = homeserver_url.join("/_matrix/client/v3/login")?;
+
+    let data_dir = session_data_dir()?;
+    if data_dir.exists() {
+        fs::remove_dir_all(&data_dir).await?;
+    }
+    fs::create_dir_all(&data_dir).await?;
+
+    let client_session = build_client_session(&data_dir, &homeserver_url);
+    let client = Client::builder()
+        .homeserver_url(homeserver_url.clone())
+        .sqlite_store(&client_session.db_path, Some(&client_session.passphrase))
+        .build()
+        .await?;
+
+    let http_client = reqwest::Client::new();
+    let challenge =
+        request_challenge(&http_client, login_url.clone(), &wallet.classic_address, network)
+            .await?;
+    let signature = sign(challenge.challenge.as_bytes(), &wallet.private_key)
+        .map_err(|error| anyhow!("failed to sign challenge: {error:?}"))?;
+    let login_response = complete_login(
+        &http_client,
+        login_url,
+        &challenge,
+        &wallet.classic_address,
+        &wallet.public_key,
+        &signature,
+    )
+    .await?;
+
+    let user_session = MatrixSession {
+        meta: SessionMeta {
+            user_id: login_response.user_id.clone(),
+            device_id: login_response.device_id.clone(),
+        },
+        tokens: SessionTokens {
+            access_token: login_response.access_token.clone(),
+            refresh_token: login_response.refresh_token.clone(),
+        },
+    };
+    client.matrix_auth().restore_session(user_session.clone(), RoomLoadSettings::default()).await?;
+
+    let stored_session = StoredSession {
+        client_session,
+        user_session,
+        linked_wallet: Some(LinkedWalletSession {
+            address: wallet.classic_address.clone(),
+            network: network.to_owned(),
+            public_key: wallet.public_key.clone(),
+        }),
+    };
+    persist_session(&stored_session).await?;
+
+    println!("Logged in as {}", login_response.user_id);
+    println!("Session persisted in {}", session_file_path()?.to_string_lossy(),);
+
+    Ok(())
+}
+
+async fn show_linked_address() -> anyhow::Result<()> {
+    let stored_session = load_session().await?;
+    let Some(linked_wallet) = stored_session.linked_wallet else {
+        bail!("no linked XRPL wallet was found in the stored session");
+    };
+
+    println!("{} ({})", linked_wallet.address, linked_wallet.network);
+    Ok(())
+}
+
+async fn request_challenge(
+    http_client: &reqwest::Client,
+    login_url: Url,
+    address: &str,
+    network: &str,
+) -> anyhow::Result<ChallengeResponse> {
+    let response = http_client
+        .post(login_url)
+        .json(&ChallengeRequest { login_type: XRPL_LOGIN_TYPE, address, network })
+        .send()
+        .await?;
+
+    let status = response.status();
+    let body = response.text().await?;
+    if status != StatusCode::UNAUTHORIZED {
+        bail!("expected HTTP 401 challenge response, got {status}: {body}");
+    }
+
+    Ok(serde_json::from_str(&body)?)
+}
+
+async fn complete_login(
+    http_client: &reqwest::Client,
+    login_url: Url,
+    challenge: &ChallengeResponse,
+    address: &str,
+    public_key: &str,
+    signature: &str,
+) -> anyhow::Result<LoginResponseBody> {
+    let response = http_client
+        .post(login_url)
+        .json(&CompleteLoginRequest {
+            login_type: XRPL_LOGIN_TYPE,
+            session: &challenge.session,
+            address,
+            signature,
+            public_key,
+        })
+        .send()
+        .await?;
+
+    let status = response.status();
+    let body = response.text().await?;
+    if !status.is_success() {
+        bail!("login failed with HTTP {status}: {body}");
+    }
+
+    Ok(serde_json::from_str(&body)?)
+}
+
+fn normalize_homeserver_url(raw: &str) -> anyhow::Result<Url> {
+    Ok(Url::parse(raw)?)
+}
+
+fn build_client_session(data_dir: &Path, homeserver: &Url) -> ClientSession {
+    let db_path = data_dir.join("db");
+    let passphrase: String =
+        thread_rng().sample_iter(Alphanumeric).take(32).map(char::from).collect();
+
+    ClientSession { homeserver: homeserver.to_string(), db_path, passphrase }
+}
+
+fn session_data_dir() -> anyhow::Result<PathBuf> {
+    Ok(dirs::data_dir()
+        .context("unable to resolve a local data directory for briij-cli")?
+        .join("briij-cli"))
+}
+
+fn session_file_path() -> anyhow::Result<PathBuf> {
+    Ok(session_data_dir()?.join("session.json"))
+}
+
+async fn persist_session(stored_session: &StoredSession) -> anyhow::Result<()> {
+    let session_file = session_file_path()?;
+    let serialized = serde_json::to_string(stored_session)?;
+    fs::write(session_file, serialized).await?;
+    Ok(())
+}
+
+async fn load_session() -> anyhow::Result<StoredSession> {
+    let session_file = session_file_path()?;
+    let serialized = fs::read_to_string(session_file).await?;
+    Ok(serde_json::from_str(&serialized)?)
+}
